index 0000000..ad26890
--- /dev/null
+++ b/src/recommendation/build_career_skills.py
@@ -0,0 +1,96 @@
+"""Phase 5 step: build career skill profiles -> data/processed/career_skills.csv.
+
+    python src/recommendation/build_career_skills.py [--min-postings 30]
+
+Joins staging postings, weak career labels (Phase 3) and extracted skills (Phase 4) and
+writes one row per (career, skill) with ``frequency`` and ``importance`` (see
+profiles.py). This is the editable-data form of the career profiles that the engine reads;
+nothing about careers is hard-coded in the engine (explainability rule 7).
+
+Caveats: labels are weak title-derived labels, skills come from a rule extractor, and
+small corpora give lumpy shares. ``low_sample`` marks careers below ``--min-postings``.
+Standard library only.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from src.etl.common import (  # noqa: E402
+    CAREER_SKILL_COLUMNS, CAREER_SKILLS_CSV, JOB_SKILL_COLUMNS, JOB_SKILLS_CSV, LABEL_COLUMNS,
+    LABELS_CSV, STAGING_COLUMNS, STAGING_CSV, EtlError, read_csv, write_csv,
+)
+from src.nlp.skill_dictionary import CAREERS_CSV, SkillDictionary  # noqa: E402
+from src.nlp.skill_extractor import EXTRACTOR_METHOD  # noqa: E402
+from src.recommendation.profiles import DEFAULT_MIN_POSTINGS, CorpusCounts, postings_from_rows  # noqa: E402
+
+
+def career_names(path: Path = CAREERS_CSV) -> dict[str, str]:
+    with Path(path).open(newline="", encoding="utf-8") as fh:
+        return {r["career_id"]: r["career_name"] for r in csv.DictReader(fh)}
+
+
+def build(staging_rows: list[dict], label_rows: list[dict], job_skills_rows: list[dict],
+          min_postings: int = DEFAULT_MIN_POSTINGS, skills: SkillDictionary | None = None) -> list[dict]:
+    skills = skills or SkillDictionary.load()
+    staged = {r["job_id"] for r in staging_rows}
+    stale = [js["job_id"] for js in job_skills_rows if js["job_id"] not in staged]
+    if stale:
+        raise EtlError(f"job_skills.csv refers to {stale[0]}, which is not in staging; "
+                       "rerun extract_job_skills.py after build_staging.py")
+    postings = postings_from_rows(staging_rows, label_rows, job_skills_rows)
+    if not postings:
+        raise EtlError("no labeled postings; nothing to build career profiles from")
+    counts = CorpusCounts(postings, career_names(), min_postings)
+    rows: list[dict] = []
+    for cid, prof in counts.profiles().items():
+        for sid, st in sorted(prof.skills.items(), key=lambda kv: (-kv[1].importance, kv[0])):
+            sk = skills.skills[sid]
+            rows.append({
+                "career_id": cid, "career_name": prof.career_name, "skill_id": sid,
+                "canonical_name": sk.canonical_name, "category": sk.category,
+                "postings_with_skill": st.count, "postings_in_career": prof.postings,
+                "frequency": f"{st.frequency:.4f}", "importance": f"{st.importance:.4f}",
+                "low_sample": prof.low_sample, "synthetic_postings_in_career": prof.synthetic_postings,
+                "method": f"job_skills:{EXTRACTOR_METHOD}",
+            })
+    return rows
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description="Build career skill profiles.")
+    ap.add_argument("--staging", default=str(STAGING_CSV))
+    ap.add_argument("--labels", default=str(LABELS_CSV))
+    ap.add_argument("--job-skills", default=str(JOB_SKILLS_CSV))
+    ap.add_argument("--out", default=str(CAREER_SKILLS_CSV))
+    ap.add_argument("--min-postings", type=int, default=DEFAULT_MIN_POSTINGS,
+                    help="careers with fewer postings are flagged low_sample")
+    args = ap.parse_args(argv)
+    try:
+        rows = build(read_csv(Path(args.staging), STAGING_COLUMNS),
+                     read_csv(Path(args.labels), LABEL_COLUMNS),
+                     read_csv(Path(args.job_skills), JOB_SKILL_COLUMNS), args.min_postings)
+        write_csv(Path(args.out), CAREER_SKILL_COLUMNS, rows)
+    except (EtlError, ValueError, OSError) as e:
+        print(f"CAREER PROFILES FAILED: {e}")
+        return 1
+    per = {}
+    for r in rows:
+        per[r["career_id"]] = (r["career_name"], int(r["postings_in_career"]), r["low_sample"])
+    print("CAREER PROFILES COMPLETE")
+    print(f"  careers: {len(per)}  rows: {len(rows)}")
+    for cid, (name, n, low) in sorted(per.items()):
+        print(f"    {cid} {name}: {n} postings" + ("  (low sample)" if low == "true" else ""))
+    print("  NOTE: derived from weak title labels and extracted skills; sample statistics only.")
+    print(f"  output: {args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/recommendation/engine.py b/src/recommendation/engine.py
new file mode 100644
index 0000000..d0dfd79
--- /dev/null
+++ b/src/recommendation/engine.py
@@ -0,0 +1,267 @@
+"""Career recommendation and skill-gap engine (Phase 5).
+
+Models (docs/evaluation_strategy.md section 4, increasing sophistication):
+
+* ``popularity_v0``        baseline 1: the same ranking for everyone, by posting volume.
+* ``keyword_overlap_v0``   baseline 2: how many of the profile's skills the career mentions.
+* ``tfidf_cosine_v0``      baseline 3: TF-IDF cosine between profile and career skill vector.
+* ``weighted_coverage_v1`` the engine: the share of a career's total skill importance that
+                           the profile already covers (see ``score_weighted_coverage``).
+
+Scores are *compatibility scores*, never probabilities of being hired (explainability
+rule 1). Every recommendation lists matched and missing skills with the career's
+importance and observed frequency (rule 2); frequencies are sample statistics (rule 3).
+The engine has no built-in career or skill catalog: it reads career profiles produced
+from data (profiles.py) and prerequisite pairs from reference data (rule 7).
+
+Standard library only.
+"""
+from __future__ import annotations
+
+import csv
+import math
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from src.nlp.skill_dictionary import SkillDictionary
+from src.recommendation.profiles import CareerProfile
+
+MODEL_VERSION = "weighted_coverage_v1"
+BASELINE_MODELS = ("popularity_v0", "keyword_overlap_v0", "tfidf_cosine_v0")
+
+DISCLAIMER = ("Scores show how closely your current skills match each career's typical "
+              "requirements in our sample of job postings. They do not predict whether you "
+              "will be hired.")
+DATA_LIMITS = ("Demand figures are sample statistics from the acquired job corpus, not a "
+               "definitive ranking of the Kenyan labour market.")
+
+ROOT = Path(__file__).resolve().parents[2]
+PREREQUISITES_CSV = ROOT / "data" / "reference" / "skill_prerequisites.csv"
+
+
+# ------------------------------------------------------------------ scoring models
+Scores = dict  # career_id -> float
+
+
+def score_popularity(skills: frozenset, profiles: dict) -> Scores:
+    total = sum(p.postings for p in profiles.values()) or 1
+    return {cid: p.postings / total for cid, p in profiles.items()}
+
+
+def score_keyword_overlap(skills: frozenset, profiles: dict) -> Scores:
+    if not skills:
+        return {cid: 0.0 for cid in profiles}
+    return {cid: len(skills & set(p.skills)) / len(skills) for cid, p in profiles.items()}
+
+
+def score_tfidf_cosine(skills: frozenset, profiles: dict) -> Scores:
+    n_careers = len(profiles)
+    df: dict[str, int] = {}
+    for p in profiles.values():
+        for sid in p.skills:
+            df[sid] = df.get(sid, 0) + 1
+    idf = {sid: math.log((n_careers + 1) / (d + 1)) + 1.0 for sid, d in df.items()}
+    query = {sid: idf[sid] for sid in skills if sid in idf}
+    q_norm = math.sqrt(sum(v * v for v in query.values()))
+    out: Scores = {}
+    for cid, p in profiles.items():
+        vec = {sid: st.frequency * idf[sid] for sid, st in p.skills.items()}
+        v_norm = math.sqrt(sum(v * v for v in vec.values()))
+        dot = sum(w * vec.get(sid, 0.0) for sid, w in query.items())
+        out[cid] = dot / (q_norm * v_norm) if q_norm and v_norm else 0.0
+    return out
+
+
+def score_weighted_coverage(skills: frozenset, profiles: dict) -> Scores:
+    """Compatibility = sum of career importance over the skills you have, divided by the sum
+    over all the career's skills: "how much of what this career typically asks for (weighted
+    by importance) do you already cover". Range 0 to 1; 1 means every skill the sampled
+    postings ask for. Skills you have that the career does not ask for do not count for or
+    against it."""
+    out: Scores = {}
+    for cid, p in profiles.items():
+        total = sum(st.importance for st in p.skills.values())
+        have = sum(st.importance for sid, st in p.skills.items() if sid in skills)
+        out[cid] = have / total if total else 0.0
+    return out
+
+
+MODELS = {
+    "popularity_v0": score_popularity,
+    "keyword_overlap_v0": score_keyword_overlap,
+    "tfidf_cosine_v0": score_tfidf_cosine,
+    MODEL_VERSION: score_weighted_coverage,
+}
+
+
+def rank_careers(scores: Scores, profiles: dict) -> list[str]:
+    """Deterministic ranking: score, then posting volume, then career_id."""
+    return sorted(scores, key=lambda c: (-round(scores[c], 12), -profiles[c].postings, c))
+
+
+# ------------------------------------------------------------------ evidence
+@dataclass(frozen=True)
+class SkillEvidence:
+    skill_id: str
+    canonical_name: str
+    display_name: str
+    category: str
+    frequency: float
+    importance: float
+    postings_with_skill: int
+    postings: int
+    reason: str
+
+
+@dataclass(frozen=True)
+class CareerMatch:
+    rank: int
+    career_id: str
+    career_name: str
+    score: float
+    postings: int
+    low_sample: bool
+    matched: list
+    missing: list
+    model_version: str
+    tied_with: int = 0      # other careers with exactly the same score (rank order among them is arbitrary)
+
+
+def _evidence(sid: str, prof: CareerProfile, dictionary: SkillDictionary, have: bool) -> SkillEvidence:
+    st, sk = prof.skills[sid], dictionary.skills[sid]
+    share = f"appears in {st.frequency:.0%} of {prof.postings} sampled {prof.career_name} postings"
+    reason = f"{'you have it; ' if have else ''}{share} (importance {st.importance:.2f})"
+    return SkillEvidence(sid, sk.canonical_name, sk.display_name, sk.category, st.frequency,
+                         st.importance, st.count, prof.postings, reason)
+
+
+def _by_weight(profile: CareerProfile, ids) -> list[str]:
+    return sorted(ids, key=lambda s: (-profile.skills[s].importance, -profile.skills[s].frequency, s))
+
+
+def recommend(skill_ids, profiles: dict, dictionary: SkillDictionary,
+              model: str = MODEL_VERSION, top: int | None = None) -> list[CareerMatch]:
+    """Rank careers for a profile and attach matched/missing skill evidence to each."""
+    if model not in MODELS:
+        raise ValueError(f"unknown model {model!r}; choose from {sorted(MODELS)}")
+    skills = frozenset(skill_ids)
+    scores = MODELS[model](skills, profiles)
+    out = []
+    rounded = [round(v, 9) for v in scores.values()]
+    for rank, cid in enumerate(rank_careers(scores, profiles), 1):
+        prof = profiles[cid]
+        matched = _by_weight(prof, [s for s in prof.skills if s in skills])
+        missing = _by_weight(prof, [s for s in prof.skills if s not in skills])
+        out.append(CareerMatch(
+            rank, cid, prof.career_name, scores[cid], prof.postings, prof.low_sample,
+            [_evidence(s, prof, dictionary, True) for s in matched],
+            [_evidence(s, prof, dictionary, False) for s in missing], model,
+            rounded.count(round(scores[cid], 9)) - 1))
+    return out[:top] if top else out
+
+
+# ------------------------------------------------------------------ skill-gap analysis
+@dataclass(frozen=True)
+class GapItem:
+    priority: int
+    skill_id: str
+    canonical_name: str
+    display_name: str
+    importance: float
+    frequency: float
+    postings_with_skill: int
+    postings: int
+    requires: list = field(default_factory=list)   # [(display_name, you_have_it)]
+    reason: str = ""
+    resource: str | None = None                    # filled in by Phase 6 (learning resources)
+
+
+@dataclass(frozen=True)
+class GapReport:
+    career_id: str
+    career_name: str
+    postings: int
+    low_sample: bool
+    have: list
+    missing: list
+
+
+def load_prerequisites(path: Path | str | None, dictionary: SkillDictionary) -> dict[str, list[str]]:
+    """Read skill -> [prerequisite skills] from reference data; reject unknown names and cycles."""
+    p = Path(path) if path else PREREQUISITES_CSV
+    pre: dict[str, list[str]] = {}
+    with p.open(newline="", encoding="utf-8") as fh:
+        for r in csv.DictReader(fh):
+            a, b = dictionary.by_canonical.get(r["skill"]), dictionary.by_canonical.get(r["requires"])
+            if a is None or b is None:
+                raise ValueError(f"prerequisite row {r['skill']!r} -> {r['requires']!r}: unknown skill name")
+            if b.skill_id not in pre.setdefault(a.skill_id, []):
+                pre[a.skill_id].append(b.skill_id)
+    state: dict[str, int] = {}
+
+    def visit(s: str) -> None:
+        if state.get(s) == 1:
+            raise ValueError(f"prerequisite cycle through {dictionary.skills[s].canonical_name}")
+        if state.get(s) == 2:
+            return
+        state[s] = 1
+        for q in pre.get(s, []):
+            visit(q)
+        state[s] = 2
+
+    for s in list(pre):
+        visit(s)
+    return pre
+
+
+def gap_analysis(skill_ids, profile: CareerProfile, dictionary: SkillDictionary,
+                 prerequisites: dict[str, list[str]] | None = None) -> GapReport:
+    """Missing skills for one career, ordered by importance, then by observed frequency, with
+    prerequisites placed before the skills that build on them (when both are missing)."""
+    prerequisites = prerequisites or {}
+    skills = frozenset(skill_ids)
+    missing_ids = set(s for s in profile.skills if s not in skills)
+    base = _by_weight(profile, missing_ids)
+
+    order: list[str] = []
+    seen: set[str] = set()
+
+    def emit(s: str) -> None:
+        if s in seen:
+            return
+        seen.add(s)
+        for q in prerequisites.get(s, []):
+            if q in missing_ids:
+                emit(q)
+        order.append(s)
+
+    for s in base:
+        emit(s)
+
+    items = []
+    for i, s in enumerate(order, 1):
+        st = profile.skills[s]
+        reqs = [(dictionary.skills[q].display_name, q in skills) for q in prerequisites.get(s, [])]
+        reason = (f"appears in {st.frequency:.0%} of {profile.postings} sampled "
+                  f"{profile.career_name} postings (importance {st.importance:.2f})")
+        if reqs:
+            parts = [f"{n} ({'you have it' if ok else 'missing, learn first'})" for n, ok in reqs]
+            reason += "; builds on " + ", ".join(parts)
+        items.append(GapItem(i, s, dictionary.skills[s].canonical_name, dictionary.skills[s].display_name,
+                             st.importance, st.frequency,
+                             st.count, profile.postings, reqs, reason))
+    have = [_evidence(s, profile, dictionary, True) for s in _by_weight(profile, [s for s in profile.skills if s in skills])]
+    return GapReport(profile.career_id, profile.career_name, profile.postings, profile.low_sample, have, items)
+
+
+# ------------------------------------------------------------------ profile input
+def resolve_skills(raw_skills: list[str], dictionary: SkillDictionary) -> tuple[frozenset, list[str]]:
+    """Map free-text skill entries to skill ids. Unrecognised entries are returned, not dropped silently."""
+    ids, unknown = set(), []
+    for raw in raw_skills:
+        sk = dictionary.lookup(raw)
+        if sk is None:
+            unknown.append(raw)
+        else:
+            ids.add(sk.skill_id)
+    return frozenset(ids), unknown
diff --git a/src/recommendation/profiles.py b/src/recommendation/profiles.py
new file mode 100644
index 0000000..c11bb6d
--- /dev/null
+++ b/src/recommendation/profiles.py
@@ -0,0 +1,124 @@
+"""Career skill profiles built from observed postings (Phase 5).
+
+A career profile answers "what do sampled postings for this career ask for?":
+
+* ``frequency``  = share of the career's postings that mention the skill;
+* ``importance`` = mean over the career's postings of the posting-level importance
+  (1.0 normally, 0.5 where the posting says the skill is "a plus"; 0 where absent).
+  It is therefore always <= frequency and in [0, 1].
+
+Postings are assigned to careers by the Phase 3 weak title labels; skills come from the
+Phase 4 extractor. Both are imperfect, and with small corpora the shares are lumpy: every
+profile carries ``postings`` and ``low_sample`` so callers can say so (explainability
+rule 3). Standard library only.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+DEFAULT_MIN_POSTINGS = 30  # careers with fewer postings are flagged low_sample
+
+
+@dataclass(frozen=True)
+class Posting:
+    job_id: str
+    career_id: str
+    skills: dict          # skill_id -> posting-level importance in (0, 1]
+    synthetic: bool = False
+
+
+@dataclass(frozen=True)
+class SkillStat:
+    count: int            # postings mentioning the skill
+    frequency: float      # count / postings
+    importance: float     # sum of posting importance / postings
+
+
+@dataclass
+class CareerProfile:
+    career_id: str
+    career_name: str
+    postings: int
+    synthetic_postings: int
+    low_sample: bool
+    skills: dict = field(default_factory=dict)   # skill_id -> SkillStat
+
+
+class CorpusCounts:
+    """Per-career counts from which profiles are derived; supports leave-one-out."""
+
+    def __init__(self, postings: list[Posting], career_names: dict[str, str],
+                 min_postings: int = DEFAULT_MIN_POSTINGS):
+        self.career_names = career_names
+        self.min_postings = min_postings
+        self.n: dict[str, int] = {}
+        self.syn: dict[str, int] = {}
+        self.count: dict[str, dict[str, int]] = {}
+        self.imp: dict[str, dict[str, float]] = {}
+        for p in postings:
+            self._add(p, +1)
+
+    def _add(self, p: Posting, sign: int) -> None:
+        c = p.career_id
+        self.n[c] = self.n.get(c, 0) + sign
+        self.syn[c] = self.syn.get(c, 0) + sign * int(p.synthetic)
+        cc, ii = self.count.setdefault(c, {}), self.imp.setdefault(c, {})
+        for sid, w in p.skills.items():
+            cc[sid] = cc.get(sid, 0) + sign
+            ii[sid] = ii.get(sid, 0.0) + sign * w
+
+    def profile(self, career_id: str, exclude: Posting | None = None) -> CareerProfile | None:
+        """Profile of one career, optionally without one posting. None if no postings remain."""
+        n, syn = self.n.get(career_id, 0), self.syn.get(career_id, 0)
+        cc, ii = self.count.get(career_id, {}), self.imp.get(career_id, {})
+        if exclude is not None and exclude.career_id == career_id:
+            n, syn = n - 1, syn - int(exclude.synthetic)
+            cc, ii = dict(cc), dict(ii)
+            for sid, w in exclude.skills.items():
+                cc[sid] -= 1
+                ii[sid] -= w
+        if n <= 0:
+            return None
+        skills = {sid: SkillStat(c, c / n, round(ii[sid], 9) / n)
+                  for sid, c in cc.items() if c > 0}
+        return CareerProfile(career_id, self.career_names.get(career_id, career_id), n, syn,
+                             n < self.min_postings, skills)
+
+    def profiles(self, exclude: Posting | None = None) -> dict[str, CareerProfile]:
+        out = {}
+        for cid in sorted(self.n):
+            prof = self.profile(cid, exclude)
+            if prof is not None:
+                out[cid] = prof
+        return out
+
+
+def postings_from_rows(staging_rows: list[dict], label_rows: list[dict],
+                       job_skills_rows: list[dict]) -> list[Posting]:
+    """Join staging, weak labels and extracted skills into Postings (labeled ones only)."""
+    label_by_job = {l["job_id"]: l for l in label_rows}
+    skills_by_job: dict[str, dict] = {}
+    for js in job_skills_rows:
+        skills_by_job.setdefault(js["job_id"], {})[js["skill_id"]] = float(js["importance"])
+    out = []
+    for r in sorted(staging_rows, key=lambda r: r["job_id"]):
+        label = label_by_job.get(r["job_id"])
+        if not label or not label["career_id"]:
+            continue
+        out.append(Posting(r["job_id"], label["career_id"], skills_by_job.get(r["job_id"], {}),
+                           r["is_synthetic"] == "true"))
+    return out
+
+
+def profiles_from_career_skill_rows(rows: list[dict]) -> dict[str, CareerProfile]:
+    """Rebuild profiles from career_skills.csv rows."""
+    out: dict[str, CareerProfile] = {}
+    for r in rows:
+        prof = out.get(r["career_id"])
+        if prof is None:
+            prof = out[r["career_id"]] = CareerProfile(
+                r["career_id"], r["career_name"], int(r["postings_in_career"]),
+                int(r["synthetic_postings_in_career"]), r["low_sample"] == "true")
+        prof.skills[r["skill_id"]] = SkillStat(
+            int(r["postings_with_skill"]), float(r["frequency"]), float(r["importance"]))
+    return out
diff --git a/src/recommendation/recommend.py b/src/recommendation/recommend.py
new file mode 100644
index 0000000..68d224c
--- /dev/null
+++ b/src/recommendation/recommend.py
@@ -0,0 +1,160 @@
+"""Recommend careers and show the skill gap for one graduate profile (Phase 5).
+
+    python src/recommendation/recommend.py                       # uses the demo profile
+    python src/recommendation/recommend.py --profile my.json --target CA03
+    python src/recommendation/recommend.py --expect-top CA01     # exit 2 if the top career differs
+
+Reads ``data/processed/career_skills.csv`` (build it with build_career_skills.py) and a
+profile JSON (see data/reference/demo_profile.json). Writes every ranked career to
+``data/processed/recommendations.csv`` with ``model_version`` and ``created_at``
+(explainability rule 5) and the full explanation to ``data/processed/recommendations.json``.
+Standard library only.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from dataclasses import asdict
+from datetime import datetime, timezone
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from src.etl.common import (  # noqa: E402
+    CAREER_SKILL_COLUMNS, CAREER_SKILLS_CSV, RECOMMENDATION_COLUMNS, RECOMMENDATIONS_CSV,
+    EtlError, read_csv, write_csv,
+)
+from src.nlp.skill_dictionary import SkillDictionary  # noqa: E402
+from src.recommendation.engine import (  # noqa: E402
+    DATA_LIMITS, DISCLAIMER, MODEL_VERSION, MODELS, PREREQUISITES_CSV, gap_analysis,
+    load_prerequisites, recommend, resolve_skills,
+)
+from src.recommendation.profiles import profiles_from_career_skill_rows  # noqa: E402
+
+DEFAULT_PROFILE = ROOT / "data" / "reference" / "demo_profile.json"
+RECOMMENDATIONS_JSON = ROOT / "data" / "processed" / "recommendations.json"
+
+
+def load_profile(path: Path | str) -> dict:
+    prof = json.loads(Path(path).read_text(encoding="utf-8"))
+    for key in ("profile_id", "skills"):
+        if key not in prof:
+            raise ValueError(f"profile file is missing '{key}'")
+    if not isinstance(prof["skills"], list):
+        raise ValueError("profile 'skills' must be a list of skill names")
+    return prof
+
+
+def run(profile: dict, career_skill_rows: list[dict], *, model: str = MODEL_VERSION,
+        target: str | None = None, top: int = 5, prerequisites_path: Path | str | None = None,
+        now: datetime | None = None, dictionary: SkillDictionary | None = None) -> dict:
+    """Compute recommendations and the gap report. Returns a JSON-serialisable result dict."""
+    dictionary = dictionary or SkillDictionary.load()
+    profiles = profiles_from_career_skill_rows(career_skill_rows)
+    if not profiles:
+        raise EtlError("career_skills.csv has no career profiles")
+    skills, unknown = resolve_skills(profile["skills"], dictionary)
+    if not skills:
+        raise ValueError("none of the profile's skills are in the skill taxonomy; nothing to match")
+    prereq = load_prerequisites(prerequisites_path or PREREQUISITES_CSV, dictionary)
+    created = (now or datetime.now(timezone.utc)).astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+    matches = recommend(skills, profiles, dictionary, model)
+    target_id = target or profile.get("target_career") or matches[0].career_id
+    if target_id not in profiles:
+        raise ValueError(f"target career {target_id!r} has no profile (careers with data: {sorted(profiles)})")
+    gap = gap_analysis(skills, profiles[target_id], dictionary, prereq)
+    return {
+        "profile_id": profile["profile_id"],
+        "model_version": model,
+        "created_at": created,
+        "recognized_skills": sorted(dictionary.skills[s].display_name for s in skills),
+        "unrecognized_skills": unknown,
+        "target_career": target_id,
+        "target_source": "requested" if (target or profile.get("target_career")) else "top recommendation",
+        "recommendations": [asdict(m) for m in matches],
+        "top_n": top,
+        "gap": asdict(gap),
+        "disclaimer": DISCLAIMER,
+        "data_limits": DATA_LIMITS,
+    }
+
+
+def recommendation_rows(result: dict) -> list[dict]:
+    rows = []
+    for m in result["recommendations"]:
+        rows.append({
+            "recommendation_id": f"{result['profile_id']}:{result['model_version']}:{m['career_id']}:{result['created_at']}",
+            "profile_id": result["profile_id"], "career_id": m["career_id"], "rank": m["rank"],
+            "score": f"{m['score']:.4f}", "model_version": result["model_version"],
+            "created_at": result["created_at"], "matched_skills": len(m["matched"]),
+            "missing_skills": len(m["missing"]), "postings_in_career": m["postings"],
+            "low_sample": m["low_sample"],
+        })
+    return rows
+
+
+def render(result: dict) -> str:
+    out = [f"Profile {result['profile_id']}: {', '.join(result['recognized_skills'])}"]
+    if result["unrecognized_skills"]:
+        out.append(f"  Not recognised (ignored): {', '.join(result['unrecognized_skills'])}")
+    out.append(f"\nCareer matches by compatibility score (model {result['model_version']}):")
+    for m in result["recommendations"][: result["top_n"]]:
+        flag = f"  [low sample: {m['postings']} postings]" if m["low_sample"] else f"  [{m['postings']} postings]"
+        if m["tied_with"]:
+            flag += f"  [tied with {m['tied_with']} other career(s): order among them is arbitrary]"
+        out.append(f"{m['rank']}. {m['career_name']} - {m['score']:.0%} compatibility{flag}")
+        matched = ", ".join(f"{e['display_name']} ({e['frequency']:.0%})" for e in m["matched"][:4]) or "none"
+        missing = ", ".join(f"{e['display_name']} ({e['frequency']:.0%})" for e in m["missing"][:3]) or "none"
+        out.append(f"   Matched: {matched}")
+        out.append(f"   Potential gaps: {missing}")
+    gap = result["gap"]
+    out.append(f"\nSkill gap for {gap['career_name']} ({result['target_source']}):")
+    out.append("  Already have: " + (", ".join(e["display_name"] for e in gap["have"]) or "none"))
+    if gap["missing"]:
+        out.append("  Priority: " + " -> ".join(g["display_name"] for g in gap["missing"]))
+        for g in gap["missing"][:6]:
+            out.append(f"    {g['priority']}. {g['display_name']}: {g['reason']}")
+    else:
+        out.append("  No gaps against this career's sampled requirements.")
+    out.append("  (Learning resources for each gap arrive in Phase 6.)")
+    out.append(f"\n{result['disclaimer']}\n{result['data_limits']}")
+    return "\n".join(out)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description="Career recommendations and skill gap for a profile.")
+    ap.add_argument("--profile", default=str(DEFAULT_PROFILE))
+    ap.add_argument("--career-skills", default=str(CAREER_SKILLS_CSV))
+    ap.add_argument("--model", default=MODEL_VERSION, choices=sorted(MODELS))
+    ap.add_argument("--target", default=None, help="career_id for the gap analysis (default: top match)")
+    ap.add_argument("--top", type=int, default=5)
+    ap.add_argument("--prerequisites", default=str(PREREQUISITES_CSV))
+    ap.add_argument("--out", default=str(RECOMMENDATIONS_CSV))
+    ap.add_argument("--json", default=str(RECOMMENDATIONS_JSON))
+    ap.add_argument("--expect-top", default=None, help="career_id the top match must be (exit 2 if not)")
+    args = ap.parse_args(argv)
+    try:
+        profile = load_profile(args.profile)
+        rows = read_csv(Path(args.career_skills), CAREER_SKILL_COLUMNS)
+        result = run(profile, rows, model=args.model, target=args.target, top=args.top,
+                     prerequisites_path=args.prerequisites)
+        write_csv(Path(args.out), RECOMMENDATION_COLUMNS, recommendation_rows(result))
+        Path(args.json).parent.mkdir(parents=True, exist_ok=True)
+        Path(args.json).write_text(json.dumps(result, indent=2), encoding="utf-8")
+    except (EtlError, ValueError, OSError, json.JSONDecodeError) as e:
+        print(f"RECOMMENDATION FAILED: {e}")
+        return 1
+    print(render(result))
+    top = result["recommendations"][0]["career_id"]
+    if args.expect_top and top != args.expect_top:
+        print(f"\nEXPECTATION FAILED: top career is {top}, expected {args.expect_top}")
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/test_phase5_recommendation.py b/tests/test_phase5_recommendation.py
new file mode 100644
index 0000000..5192c6d
--- /dev/null
+++ b/tests/test_phase5_recommendation.py
@@ -0,0 +1,248 @@
+"""Phase 5 gate tests: career profiles, scoring models, gap analysis, evaluation, CLI.
+
+Three test functions. The README gates are cumulative; Phases 2-4 use nine and this phase
+adds three.
+"""
+from __future__ import annotations
+
+import csv
+import json
+import math
+import re
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+from src.etl import build_labels, build_staging
+from src.etl.common import CAREER_SKILL_COLUMNS, RECOMMENDATION_COLUMNS, EtlError
+from src.evaluation import recommendation_eval as ev
+from src.ingestion import job_api
+from src.nlp import extract_job_skills
+from src.nlp.skill_dictionary import SkillDictionary
+from src.recommendation import build_career_skills, recommend as rec
+from src.recommendation.engine import (
+    DATA_LIMITS, DISCLAIMER, MODEL_VERSION, MODELS, gap_analysis, load_prerequisites, rank_careers,
+    recommend, resolve_skills, score_keyword_overlap, score_popularity, score_tfidf_cosine,
+    score_weighted_coverage,
+)
+from src.recommendation.profiles import CorpusCounts, Posting
+
+ROOT = Path(__file__).resolve().parents[1]
+T0 = datetime(2026, 10, 14, 9, 0, 0, tzinfo=timezone.utc)
+SD = SkillDictionary.load()
+ID = lambda name: SD.by_canonical[name].skill_id  # noqa: E731
+
+
+def _toy_postings() -> list[Posting]:
+    sql, xl, py, pd_ = ID("sql"), ID("excel"), ID("python"), ID("pandas")
+    return [
+        Posting("a1", "CA01", {sql: 1.0, xl: 1.0}),
+        Posting("a2", "CA01", {sql: 1.0, xl: 0.5}),
+        Posting("a3", "CA01", {sql: 1.0}),
+        Posting("a4", "CA01", {sql: 1.0, xl: 1.0}),
+        Posting("b1", "CA03", {sql: 1.0, py: 1.0}),
+        Posting("b2", "CA03", {py: 1.0, pd_: 1.0}),
+    ]
+
+
+def test_profiles_scoring_models_and_gap_analysis(tmp_path):
+    names = {"CA01": "Data Analyst", "CA03": "Data Engineer"}
+    postings = _toy_postings()
+    counts = CorpusCounts(postings, names, min_postings=3)
+    profiles = counts.profiles()
+    sql, xl, py, pd_ = ID("sql"), ID("excel"), ID("python"), ID("pandas")
+
+    # Profile arithmetic checked by hand: excel is in 3 of 4 DA postings, one of them "a plus".
+    da = profiles["CA01"]
+    assert (da.postings, da.low_sample) == (4, False) and profiles["CA03"].low_sample is True
+    assert (da.skills[sql].frequency, da.skills[sql].importance) == (1.0, 1.0)
+    assert da.skills[xl].frequency == 0.75 and da.skills[xl].importance == pytest.approx(2.5 / 4)
+    assert all(st.importance <= st.frequency for p in profiles.values() for st in p.skills.values())
+
+    # Leave-one-out equals a profile built from the remaining postings (independent rebuild).
+    held = postings[1]
+    rebuilt = CorpusCounts([p for p in postings if p is not held], names, 3).profiles()
+    loo = counts.profiles(exclude=held)
+    assert {c: {s: (st.count, round(st.frequency, 9), round(st.importance, 9)) for s, st in p.skills.items()}
+            for c, p in loo.items()} == \
+           {c: {s: (st.count, round(st.frequency, 9), round(st.importance, 9)) for s, st in p.skills.items()}
+            for c, p in rebuilt.items()}
+    assert counts.profiles(exclude=postings[4])["CA03"].postings == 1  # held-out career keeps its other posting
+
+    # Scoring models by hand. DA importance mass: sql 1 + excel 0.625 = 1.625; DE: sql .5 + python 1 + pandas .5 = 2.0
+    have = frozenset({sql, xl})
+    wc = score_weighted_coverage(have, profiles)
+    assert wc["CA01"] == pytest.approx(1.0) and wc["CA03"] == pytest.approx(0.5 / 2.0)
+    assert score_weighted_coverage(frozenset({sql}), profiles)["CA01"] == pytest.approx(1 / 1.625)
+    assert score_weighted_coverage(frozenset(), profiles) == {"CA01": 0.0, "CA03": 0.0}
+    assert score_popularity(have, profiles) == {"CA01": pytest.approx(4 / 6), "CA03": pytest.approx(2 / 6)}
+    assert score_popularity(frozenset(), profiles) == score_popularity(frozenset({py}), profiles)  # profile-blind
+    ko = score_keyword_overlap(have, profiles)
+    assert ko == {"CA01": 1.0, "CA03": 0.5}
+    tf = score_tfidf_cosine(have, profiles)
+    assert all(0.0 <= v <= 1.0 + 1e-9 for v in tf.values()) and tf["CA01"] > tf["CA03"]
+    # TF-IDF cosine worked out by hand: 2 careers; sql is in both (idf 1), excel/python/pandas in one
+    # (idf ln(3/2)+1). Query = {sql, excel}; career vectors use posting frequency x idf.
+    i1, i2 = 1.0, math.log(3 / 2) + 1
+    q_norm = math.sqrt(i1 ** 2 + i2 ** 2)
+    v1 = {"sql": 1.0 * i1, "excel": 0.75 * i2}
+    v3 = {"sql": 0.5 * i1, "python": 1.0 * i2, "pandas": 0.5 * i2}
+    assert tf["CA01"] == pytest.approx((1 * v1["sql"] + i2 * v1["excel"]) / (q_norm * math.sqrt(sum(x * x for x in v1.values()))))
+    assert tf["CA03"] == pytest.approx((1 * v3["sql"]) / (q_norm * math.sqrt(sum(x * x for x in v3.values()))))
+    assert score_tfidf_cosine(frozenset({ID("kafka")}), profiles) == {"CA01": 0.0, "CA03": 0.0}
+
+    # Ranking, ties and evidence. Python-only profile: DA has no python, DE does.
+    r = recommend({py}, profiles, SD)
+    assert [m.career_id for m in r] == ["CA03", "CA01"] and r[0].score > r[1].score == 0.0
+    tied = recommend(frozenset(), profiles, SD)                      # all scores 0 -> arbitrary order, flagged
+    assert [m.tied_with for m in tied] == [1, 1] and tied[0].career_id == "CA01"  # volume breaks the tie
+    top = recommend(have, profiles, SD)[0]
+    assert [e.canonical_name for e in top.matched] == ["sql", "excel"]            # sorted by importance
+    assert top.matched[0].reason.startswith("you have it; appears in 100% of 4 sampled Data Analyst postings")
+    assert top.missing == [] and top.model_version == MODEL_VERSION
+    de_missing = recommend(have, profiles, SD)[1].missing
+    assert [e.canonical_name for e in de_missing] == ["python", "pandas"] and all(e.skill_id in SD.skills for e in de_missing)
+    with pytest.raises(ValueError, match="unknown model"):
+        recommend(have, profiles, SD, model="magic_v9")
+
+    # Gap analysis: prerequisites come first even when the dependent skill is more important.
+    prereq = load_prerequisites(None, SD)
+    assert prereq[ID("pandas")] == [ID("python")]
+    de = profiles["CA03"]
+    gap = gap_analysis({ID("sql")}, de, SD, prereq)
+    assert [g.canonical_name for g in gap.missing] == ["python", "pandas"]         # python (1.0) before pandas (.5)
+    boosted = CorpusCounts([Posting("x", "CA03", {py: 0.5, pd_: 1.0})], names, 1).profiles()["CA03"]
+    gap2 = gap_analysis(frozenset(), boosted, SD, prereq)
