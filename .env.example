# Copy to .env and replace every placeholder before use. Never commit .env.
# Used from Phase 3 (PostgreSQL) and Phase 7 (API + Docker).

POSTGRES_DB=graduate_skill_gap
POSTGRES_USER=ujuzify
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Shared API key for /recommend and /feedback (Phase 7). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change_me_to_a_random_key

# development | staging | production
APP_ENV=development

# Local default; inside Docker Compose the host will be the db service name.
DATABASE_URL=postgresql://ujuzify:change_me_to_a_strong_password@localhost:5432/graduate_skill_gap
