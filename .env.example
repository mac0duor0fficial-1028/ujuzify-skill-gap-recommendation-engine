# ---- Application -------------------------------------------------------------
APP_ENV=development            # set to "production" to enable HSTS
PORT=8000
WEB_CONCURRENCY=2
# Required to protect /recommend, /feedback, /metrics and /admin/reload. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
RATE_LIMIT_PER_MINUTE=90       # per client IP, per worker; 0 disables
CORS_ORIGINS=                  # comma-separated; leave empty when the UI is served by this app
CSP_CONNECT_SRC=http://localhost:* http://127.0.0.1:*   # extra hosts the browser UI may call

# ---- Optional LLM for the coach (the built-in deterministic coach is the default) ----
LLM_BASE_URL=                  # any OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=

# ---- Data pipeline / PostgreSQL ---------------------------------------------------
POSTGRES_DB=ujuzify
POSTGRES_USER=ujuzify
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgresql://ujuzify:change-me-too@db:5432/ujuzify
# UJUZIFY_DATA_DIR=/app/data   # override the data directory
